{
  "rewrites": [
    {
      "source": "/key/:path*",
      "destination": "/key.html"
    },
    {
      "source": "/get_key/:path*",
      "destination": "/get_key.html"
    },
    {
      "source": "/cdn/:path*",
      "destination": "http://paloma.hidencloud.com:24617/cdn/:path*"
    },
    {
      "source": "/API/fetch/External",
      "destination": "http://paloma.hidencloud.com:24617/api/fetch/External"
    },
    {
      "source": "/API/fetch/Internal",
      "destination": "http://paloma.hidencloud.com:24617/api/fetch/Internal"
    },
    {
      "source": "/hexion-upstream/:path*",
      "destination": "http://paloma.hidencloud.com:24617/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/:file*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/API/:file*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
